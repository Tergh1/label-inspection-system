@page "/images"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using client.Data
@using client.Data.Entities
@using client.Services
@attribute [Authorize]

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject InspectionWorkflowService WorkflowService
@inject InspectionUrlBuilder UrlBuilder

<PageTitle>Uploaded Images</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h1 class="mb-1">Uploaded images</h1>
        <p class="text-muted mb-0">Only your uploads are listed here.</p>
    </div>
    <a href="/images/upload" class="btn btn-primary">Upload new image</a>
</div>

@if (isLoading)
{
    <p>Loading uploaded images...</p>
}
else if (!string.IsNullOrWhiteSpace(loadError))
{
    <div class="alert alert-danger" role="alert">@loadError</div>
}
else if (images.Count == 0)
{
    <div class="empty-state">
        <h2>No uploads yet</h2>
        <p>Start by uploading an inspection image.</p>
        <a href="/images/upload" class="btn btn-primary">Upload image</a>
    </div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="alert @(isError ? "alert-danger" : "alert-success")" role="alert">@statusMessage</div>
    }

    <div class="inspection-table-panel">
        <div class="inspection-table-toolbar">
            <div class="text-muted small">
                Showing @StartItemIndex-@EndItemIndex of @images.Count uploads
            </div>

            <div class="inspection-page-size">
                <label class="form-label mb-0" for="page-size">Rows per page</label>
                <select id="page-size" class="form-select form-select-sm" value="@pageSize" @onchange="HandlePageSizeChanged">
                    @foreach (var size in PageSizeOptions)
                    {
                        <option value="@size">@size</option>
                    }
                </select>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle inspection-table">
                <thead>
                    <tr>
                        <th scope="col">Preview</th>
                        <th scope="col">Image</th>
                        <th scope="col">Uploaded</th>
                        <th scope="col">Processing</th>
                        <th scope="col">Outcome</th>
                        <th scope="col">Similarity</th>
                        <th scope="col">Tolerance</th>
                        <th scope="col">Failure</th>
                        <th scope="col" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var image in PagedImages)
                    {
                        <tr>
                            <td>
                                <img src="@UrlBuilder.BuildImageUrl(image)" alt="@image.OriginalFileName" class="inspection-thumbnail" />
                            </td>
                            <td>
                                <div class="inspection-file-cell">
                                    <div class="fw-semibold">@image.OriginalFileName</div>
                                    <div class="text-muted small">@FormatBytes(image.FileSizeBytes)</div>
                                    @if (!string.IsNullOrWhiteSpace(image.Description))
                                    {
                                        <div class="text-muted small inspection-description">@image.Description</div>
                                    }
                                </div>
                            </td>
                            <td>@image.CreatedAtUtc.LocalDateTime.ToString("g")</td>
                            <td>@image.ProcessingStatus</td>
                            <td>
                                <span class="badge rounded-pill inspection-outcome-badge @GetOutcomeBadgeClass(image.OutcomeStatus)">@image.OutcomeStatus</span>
                            </td>
                            <td>@GetSimilarityLabel(image.SimilarityPercent)</td>
                            <td>
                                @image.TolerancePercent.ToString("0.##")% (Min similarity @image.MinimumSimilarityPercent.ToString("0.##")%)
                            </td>
                            <td>@(string.IsNullOrWhiteSpace(image.FailureReason) ? "-" : image.FailureReason)</td>
                            <td class="text-end">
                                <div class="inspection-row-actions">
                                    <button type="button"
                                            class="btn btn-sm btn-outline-secondary inspection-row-menu-button"
                                            aria-label="Open actions"
                                            aria-expanded="@(openMenuImageId == image.Id)"
                                            @onclick="() => ToggleMenu(image.Id)">
                                        ...
                                    </button>

                                    @if (openMenuImageId == image.Id)
                                    {
                                        <div class="inspection-row-menu" role="menu">
                                            <button type="button"
                                                    class="dropdown-item text-danger"
                                                    role="menuitem"
                                                    @onclick="() => PromptDelete(image)">
                                                Delete
                                            </button>

                                            @if (CanInspectAgain(image))
                                            {
                                                <button type="button"
                                                        class="dropdown-item"
                                                        role="menuitem"
                                                        disabled="@isBusy"
                                                        @onclick="() => InspectAgainAsync(image)">
                                                    Inspect again
                                                </button>
                                            }

                                            @if (CanShowDefects(image))
                                            {
                                                <button type="button"
                                                        class="dropdown-item"
                                                        role="menuitem"
                                                        @onclick="ShowDefects">
                                                    Show defects
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="inspection-pagination">
            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="PreviousPage" disabled="@(currentPage == 1)">
                Previous
            </button>

            <div class="inspection-page-list" role="navigation" aria-label="Uploaded images pages">
                @foreach (var pageNumber in PageNumbers)
                {
                    <button type="button"
                            class="btn btn-sm @(pageNumber == currentPage ? "btn-primary" : "btn-outline-secondary")"
                            @onclick="() => GoToPage(pageNumber)">
                        @pageNumber
                    </button>
                }
            </div>

            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="NextPage" disabled="@(currentPage == TotalPages)">
                Next
            </button>
        </div>
    </div>
}

@if (imagePendingDelete is not null)
{
    <div class="inspection-modal-backdrop"></div>
    <div class="inspection-modal-shell" role="dialog" aria-modal="true" aria-labelledby="delete-image-title">
        <div class="inspection-modal-card">
            <h2 id="delete-image-title" class="h5 mb-2">Delete image</h2>
            <p class="text-muted mb-3">Delete <strong>@imagePendingDelete.OriginalFileName</strong>? This action cannot be undone.</p>
            <div class="d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-outline-secondary" @onclick="CancelDelete" disabled="@isBusy">Cancel</button>
                <button type="button" class="btn btn-danger" @onclick="ConfirmDeleteAsync" disabled="@isBusy">
                    @(isBusy ? "Deleting..." : "Delete")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private readonly List<InspectionImage> images = [];
    private static readonly int[] PageSizeOptions = [5, 10, 25, 50];
    private bool isLoading = true;
    private bool isBusy;
    private bool isError;
    private string? loadError;
    private string? statusMessage;
    private Guid? openMenuImageId;
    private InspectionImage? imagePendingDelete;
    private int pageSize = 10;
    private int currentPage = 1;

    private IEnumerable<InspectionImage> PagedImages => images
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize);

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(images.Count / (double)pageSize));
    private int StartItemIndex => images.Count == 0 ? 0 : ((currentPage - 1) * pageSize) + 1;
    private int EndItemIndex => Math.Min(currentPage * pageSize, images.Count);
    private IEnumerable<int> PageNumbers => Enumerable.Range(1, TotalPages);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadImagesAsync();
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadImagesAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User)
            ?? throw new InvalidOperationException("Authenticated user could not be resolved.");

        images.Clear();
        images.AddRange(await WorkflowService.GetUserImagesAsync(user.Id, CancellationToken.None));
        currentPage = Math.Min(currentPage, TotalPages);
        currentPage = Math.Max(currentPage, 1);
    }

    private static string GetOutcomeBadgeClass(OutcomeStatus status) => status switch
    {
        OutcomeStatus.Valid => "bg-success text-white",
        OutcomeStatus.ValidWithDefects => "bg-warning text-dark",
        OutcomeStatus.Invalid => "bg-danger text-white",
        _ => "bg-secondary text-white"
    };

    private static string GetSimilarityLabel(decimal? similarityPercent)
    {
        return similarityPercent.HasValue
            ? $"{similarityPercent.Value:0.##}%"
            : "N/A";
    }

    private void ToggleMenu(Guid imageId)
    {
        openMenuImageId = openMenuImageId == imageId ? null : imageId;
    }

    private static bool CanInspectAgain(InspectionImage image) => image.ProcessingStatus == ProcessingStatus.Failed;

    private static bool CanShowDefects(InspectionImage image) => image.OutcomeStatus is OutcomeStatus.ValidWithDefects or OutcomeStatus.Invalid;

    private void PromptDelete(InspectionImage image)
    {
        openMenuImageId = null;
        imagePendingDelete = image;
    }

    private void CancelDelete()
    {
        imagePendingDelete = null;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (imagePendingDelete is null)
        {
            return;
        }

        isBusy = true;
        statusMessage = null;

        try
        {
            var user = await GetCurrentUserAsync();
            await WorkflowService.DeleteAsync(user.Id, imagePendingDelete.Id, CancellationToken.None);

            images.RemoveAll(x => x.Id == imagePendingDelete.Id);
            currentPage = Math.Min(currentPage, TotalPages);
            imagePendingDelete = null;
            isError = false;
            statusMessage = "Image deleted.";
        }
        catch (Exception ex)
        {
            isError = true;
            statusMessage = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task InspectAgainAsync(InspectionImage image)
    {
        isBusy = true;
        statusMessage = null;
        openMenuImageId = null;

        try
        {
            var user = await GetCurrentUserAsync();
            var updatedImage = await WorkflowService.RedispatchFailedAsync(user.Id, image.Id, CancellationToken.None);
            ReplaceImage(updatedImage);
            isError = updatedImage.ProcessingStatus == ProcessingStatus.Failed;
            statusMessage = updatedImage.ProcessingStatus == ProcessingStatus.Failed
                ? $"ML dispatch failed: {updatedImage.FailureReason}"
                : "Image queued for inspection again.";
        }
        catch (Exception ex)
        {
            isError = true;
            statusMessage = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private void ShowDefects()
    {
        openMenuImageId = null;
    }

    private void ReplaceImage(InspectionImage updatedImage)
    {
        var index = images.FindIndex(x => x.Id == updatedImage.Id);
        if (index >= 0)
        {
            images[index] = updatedImage;
        }
    }

    private async Task<ApplicationUser> GetCurrentUserAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        return await UserManager.GetUserAsync(authState.User)
            ?? throw new InvalidOperationException("Authenticated user could not be resolved.");
    }

    private void HandlePageSizeChanged(ChangeEventArgs args)
    {
        if (args.Value is null || !int.TryParse(args.Value.ToString(), out var selectedPageSize))
        {
            return;
        }

        if (!PageSizeOptions.Contains(selectedPageSize))
        {
            return;
        }

        pageSize = selectedPageSize;
        currentPage = 1;
    }

    private void PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
        }
    }

    private void NextPage()
    {
        if (currentPage < TotalPages)
        {
            currentPage++;
        }
    }

    private void GoToPage(int pageNumber)
    {
        if (pageNumber >= 1 && pageNumber <= TotalPages)
        {
            currentPage = pageNumber;
        }
    }

    private static string FormatBytes(long bytes)
    {
        if (bytes < 1024)
        {
            return $"{bytes} B";
        }

        var kilobytes = bytes / 1024d;
        if (kilobytes < 1024)
        {
            return $"{kilobytes:F1} KB";
        }

        return $"{kilobytes / 1024d:F1} MB";
    }
}
