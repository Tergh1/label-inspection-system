@page "/images"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.JSInterop
@using System.Globalization
@using System.Text.Json
@using client.Data
@using client.Data.Entities
@using client.Services
@attribute [Authorize]

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JSRuntime
@inject UserManager<ApplicationUser> UserManager
@inject InspectionUpdateNotifier InspectionUpdateNotifier
@inject InspectionWorkflowService WorkflowService
@inject InspectionUrlBuilder UrlBuilder

<PageTitle>Uploaded Images</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h1 class="mb-1">Inspected images</h1>
        <p class="text-muted mb-0">All inspected images listed from last to the first.</p>
    </div>
    <a href="/images/upload" class="btn btn-primary">Upload image</a>
</div>

@if (isLoading)
{
    <p>Loading uploaded images...</p>
}
else if (!string.IsNullOrWhiteSpace(loadError))
{
    <div class="alert alert-danger" role="alert">@loadError</div>
}
else if (images.Count == 0)
{
    <div class="empty-state">
        <h2>No uploads yet</h2>
        <p>Start by uploading an image for inspection.</p>
        <a href="/images/upload" class="btn btn-primary">Upload image</a>
    </div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="alert @(isError ? "alert-danger" : "alert-success")" role="alert">@statusMessage</div>
    }

    <div class="inspection-table-panel">
        <div class="inspection-table-toolbar">
            <div class="text-muted small">
                Showing @StartItemIndex-@EndItemIndex of @images.Count uploads
            </div>

            <div class="inspection-page-size">
                <label class="form-label mb-0" for="page-size">Rows per page</label>
                <select id="page-size" class="form-select form-select-sm" value="@pageSize" @onchange="HandlePageSizeChanged">
                    @foreach (var size in PageSizeOptions)
                    {
                        <option value="@size">@size</option>
                    }
                </select>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle inspection-table">
                <thead>
                    <tr>
                        <th scope="col">Preview</th>
                        <th scope="col">Image</th>
                        <th scope="col">Processing</th>
                        <th scope="col">Outcome</th>
                        <th scope="col">Similarity</th>
                        <th scope="col">Tolerance</th>
                        <th scope="col">Failure</th>
                        <th scope="col" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var image in PagedImages)
                    {
                        <tr>
                            <td>
                                <img src="@UrlBuilder.BuildImageUrl(image)" alt="@image.OriginalFileName" class="inspection-thumbnail" />
                            </td>
                            <td>
                                <div class="inspection-file-cell">
                                    <div class="fw-semibold">@image.OriginalFileName</div>
                                    <div class="text-muted small">Template: @(image.Template?.FriendlyName ?? "-")</div>
                                    <div class="text-muted small">Uploaded: @image.CreatedAtUtc.LocalDateTime.ToString("g")</div>
                                    <div class="text-muted small">@FormatBytes(image.FileSizeBytes)</div>
                                    @if (!string.IsNullOrWhiteSpace(image.Description))
                                    {
                                        <div class="text-muted small inspection-description">@image.Description</div>
                                    }
                                </div>
                            </td>
                            <td>@image.ProcessingStatus</td>
                            <td>
                                <span class="badge rounded-pill inspection-outcome-badge @GetOutcomeBadgeClass(image.OutcomeStatus)">@image.OutcomeStatus</span>
                            </td>
                            <td>@GetSimilarityLabel(image.SimilarityPercent)</td>
                            <td>
                                @image.TolerancePercent.ToString("0.##")% (Min similarity @image.MinimumSimilarityPercent.ToString("0.##")%)
                            </td>
                            <td>@(string.IsNullOrWhiteSpace(image.FailureReason) ? "-" : image.FailureReason)</td>
                            <td class="text-end">
                                <div class="inspection-row-actions">
                                    <button type="button"
                                            class="btn btn-sm btn-outline-secondary inspection-row-menu-button"
                                            aria-label="Open actions"
                                            aria-expanded="@(openMenuImageId == image.Id)"
                                            @onclick="() => ToggleMenu(image.Id)">
                                        ...
                                    </button>

                                    @if (openMenuImageId == image.Id)
                                    {
                                        <div class="inspection-row-menu" role="menu">
                                            <button type="button"
                                                    class="dropdown-item text-danger"
                                                    role="menuitem"
                                                    @onclick="() => PromptDelete(image)">
                                                Delete
                                            </button>

                                            @if (CanInspectAgain(image))
                                            {
                                                <button type="button"
                                                        class="dropdown-item"
                                                        role="menuitem"
                                                        disabled="@isBusy"
                                                        @onclick="() => InspectAgainAsync(image)">
                                                    Inspect again
                                                </button>
                                            }

                                            @if (CanShowDefects(image))
                                            {
                                                <button type="button"
                                                        class="dropdown-item"
                                                        role="menuitem"
                                                        @onclick="() => ShowDefects(image)">
                                                    Show defects
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="inspection-pagination">
            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="PreviousPage" disabled="@(currentPage == 1)">
                Previous
            </button>

            <div class="inspection-page-list" role="navigation" aria-label="Uploaded images pages">
                @foreach (var pageNumber in PageNumbers)
                {
                    <button type="button"
                            class="btn btn-sm @(pageNumber == currentPage ? "btn-primary" : "btn-outline-secondary")"
                            @onclick="() => GoToPage(pageNumber)">
                        @pageNumber
                    </button>
                }
            </div>

            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="NextPage" disabled="@(currentPage == TotalPages)">
                Next
            </button>
        </div>
    </div>
}

@if (imageShowingDefects is not null)
{
    <div class="inspection-modal-backdrop" @onclick="CloseDefectsModal"></div>
    <div class="inspection-modal-shell inspection-modal-shell-wide" role="dialog" aria-modal="true" aria-labelledby="defect-viewer-title">
        <div class="inspection-modal-card inspection-modal-card-wide">
            <div class="inspection-defect-modal-header">
                <div>
                    <h2 id="defect-viewer-title" class="h5 mb-1">@imageShowingDefects.OriginalFileName</h2>
                    <p class="text-muted mb-0">
                        @defects.Count defect@(defects.Count == 1 ? string.Empty : "s")
                    </p>
                </div>
                <button type="button" class="btn btn-outline-secondary" @onclick="CloseDefectsModal">Close</button>
            </div>

            <div class="inspection-defect-modal-body">
                <div class="inspection-defect-viewer">
                    <img @ref="defectImageElement"
                         src="@UrlBuilder.BuildImageUrl(imageShowingDefects)"
                         alt="@imageShowingDefects.OriginalFileName"
                         class="inspection-defect-image" />

                    @if (defectImageDimensions is not null)
                    {
                        <svg class="inspection-defect-overlay"
                             viewBox="@GetOverlayViewBox()"
                             preserveAspectRatio="xMidYMid meet"
                             aria-hidden="true">
                            @foreach (var defect in defects)
                            {
                                <rect x="@FormatCoordinate(defect.X)"
                                      y="@FormatCoordinate(defect.Y)"
                                      width="@FormatCoordinate(defect.Width)"
                                      height="@FormatCoordinate(defect.Height)" />
                            }
                        </svg>
                    }
                </div>

                @if (defects.Count == 0)
                {
                    <p class="inspection-defect-empty text-muted mb-0">No defect coordinates available for this result.</p>
                }
            </div>
        </div>
    </div>
}

@if (imagePendingDelete is not null)
{
    <div class="inspection-modal-backdrop"></div>
    <div class="inspection-modal-shell" role="dialog" aria-modal="true" aria-labelledby="delete-image-title">
        <div class="inspection-modal-card">
            <h2 id="delete-image-title" class="h5 mb-2">Delete image</h2>
            <p class="text-muted mb-3">Delete <strong>@imagePendingDelete.OriginalFileName</strong>? This action cannot be undone.</p>
            <div class="d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-outline-secondary" @onclick="CancelDelete" disabled="@isBusy">Cancel</button>
                <button type="button" class="btn btn-danger" @onclick="ConfirmDeleteAsync" disabled="@isBusy">
                    @(isBusy ? "Deleting..." : "Delete")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private readonly List<InspectionImage> images = [];
    private static readonly int[] PageSizeOptions = [5, 10, 25, 50];
    private bool isLoading = true;
    private bool isBusy;
    private bool isError;
    private string? loadError;
    private string? statusMessage;
    private Guid? openMenuImageId;
    private ElementReference defectImageElement;
    private DotNetObjectReference<Images>? defectModalDotNetReference;
    private IDisposable? inspectionUpdateSubscription;
    private InspectionImage? imageShowingDefects;
    private InspectionImage? imagePendingDelete;
    private ImageDimensions? defectImageDimensions;
    private List<DefectBox> defects = [];
    private int pageSize = 10;
    private int currentPage = 1;
    private bool defectModalNeedsImageDimensions;
    private string? currentUserId;

    private IEnumerable<InspectionImage> PagedImages => images
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize);

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(images.Count / (double)pageSize));
    private int StartItemIndex => images.Count == 0 ? 0 : ((currentPage - 1) * pageSize) + 1;
    private int EndItemIndex => Math.Min(currentPage * pageSize, images.Count);
    private IEnumerable<int> PageNumbers => Enumerable.Range(1, TotalPages);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var user = await ResolveCurrentUserAsync();
            currentUserId = user.Id;
            inspectionUpdateSubscription = InspectionUpdateNotifier.Subscribe(currentUserId, HandleInspectionUpdatedAsync);
            await LoadImagesAsync();
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadImagesAsync()
    {
        var userId = currentUserId ?? throw new InvalidOperationException("Authenticated user could not be resolved.");

        images.Clear();
        images.AddRange(await WorkflowService.GetUserImagesAsync(userId, CancellationToken.None));
        currentPage = Math.Min(currentPage, TotalPages);
        currentPage = Math.Max(currentPage, 1);
    }

    private static string GetOutcomeBadgeClass(OutcomeStatus status) => status switch
    {
        OutcomeStatus.Valid => "bg-success text-white",
        OutcomeStatus.ValidWithDefects => "bg-warning text-dark",
        OutcomeStatus.Invalid => "bg-danger text-white",
        _ => "bg-secondary text-white"
    };

    private static string GetSimilarityLabel(decimal? similarityPercent)
    {
        return similarityPercent.HasValue
            ? $"{similarityPercent.Value:0.##}%"
            : "N/A";
    }

    private void ToggleMenu(Guid imageId)
    {
        openMenuImageId = openMenuImageId == imageId ? null : imageId;
    }

    private static bool CanInspectAgain(InspectionImage image) => image.ProcessingStatus == ProcessingStatus.Failed;

    private static bool CanShowDefects(InspectionImage image) => image.OutcomeStatus is OutcomeStatus.ValidWithDefects or OutcomeStatus.Invalid;

    private void PromptDelete(InspectionImage image)
    {
        openMenuImageId = null;
        CloseDefectsModal();
        imagePendingDelete = image;
    }

    private void CancelDelete()
    {
        imagePendingDelete = null;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (imagePendingDelete is null)
        {
            return;
        }

        isBusy = true;
        statusMessage = null;

        try
        {
            await WorkflowService.DeleteAsync(GetCurrentUserId(), imagePendingDelete.Id, CancellationToken.None);

            images.RemoveAll(x => x.Id == imagePendingDelete.Id);
            currentPage = Math.Min(currentPage, TotalPages);
            imagePendingDelete = null;
            isError = false;
            statusMessage = "Image deleted.";
        }
        catch (Exception ex)
        {
            isError = true;
            statusMessage = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task InspectAgainAsync(InspectionImage image)
    {
        isBusy = true;
        statusMessage = null;
        openMenuImageId = null;

        try
        {
            var updatedImage = await WorkflowService.RedispatchFailedAsync(GetCurrentUserId(), image.Id, CancellationToken.None);
            ReplaceImage(updatedImage);
            isError = updatedImage.ProcessingStatus == ProcessingStatus.Failed;
            statusMessage = updatedImage.ProcessingStatus == ProcessingStatus.Failed
                ? $"ML dispatch failed: {updatedImage.FailureReason}"
                : "Image queued for inspection again.";
        }
        catch (Exception ex)
        {
            isError = true;
            statusMessage = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private void ShowDefects(InspectionImage image)
    {
        openMenuImageId = null;
        imagePendingDelete = null;
        imageShowingDefects = image;
        defects = ParseDefects(image.DefectsJson);
        defectImageDimensions = null;
        defectModalNeedsImageDimensions = true;
    }

    private void CloseDefectsModal()
    {
        imageShowingDefects = null;
        defectImageDimensions = null;
        defectModalNeedsImageDimensions = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            defectModalDotNetReference = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("inspectionDefectViewer.registerEscapeHandler", defectModalDotNetReference);
        }

        if (imageShowingDefects is not null && defectModalNeedsImageDimensions)
        {
            defectImageDimensions = await JSRuntime.InvokeAsync<ImageDimensions?>(
                "inspectionDefectViewer.getImageDimensions",
                defectImageElement);

            defectModalNeedsImageDimensions = false;
            StateHasChanged();
        }
    }

    [JSInvokable]
    public Task HandleDefectModalEscape()
    {
        if (imageShowingDefects is not null)
        {
            CloseDefectsModal();
            StateHasChanged();
        }

        return Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        inspectionUpdateSubscription?.Dispose();
        defectModalDotNetReference?.Dispose();
        await JSRuntime.InvokeVoidAsync("inspectionDefectViewer.unregisterEscapeHandler");
    }

    private async Task HandleInspectionUpdatedAsync(InspectionUpdateNotification notification)
    {
        await InvokeAsync(async () =>
        {
            var updatedImage = await WorkflowService.GetUserImageAsync(GetCurrentUserId(), notification.ImageId, CancellationToken.None);
            SyncImage(updatedImage, notification.ImageId);
            StateHasChanged();
        });
    }

    private void ReplaceImage(InspectionImage updatedImage)
    {
        var index = images.FindIndex(x => x.Id == updatedImage.Id);
        if (index >= 0)
        {
            images[index] = updatedImage;
        }
    }

    private void SyncImage(InspectionImage? updatedImage, Guid imageId)
    {
        if (updatedImage is null)
        {
            images.RemoveAll(x => x.Id == imageId);

            if (openMenuImageId == imageId)
            {
                openMenuImageId = null;
            }

            if (imagePendingDelete?.Id == imageId)
            {
                imagePendingDelete = null;
            }

            if (imageShowingDefects?.Id == imageId)
            {
                CloseDefectsModal();
            }
        }
        else
        {
            ReplaceImage(updatedImage);

            if (imagePendingDelete?.Id == updatedImage.Id)
            {
                imagePendingDelete = updatedImage;
            }

            if (imageShowingDefects?.Id == updatedImage.Id)
            {
                imageShowingDefects = updatedImage;
                defects = ParseDefects(updatedImage.DefectsJson);
            }
        }

        currentPage = Math.Min(currentPage, TotalPages);
        currentPage = Math.Max(currentPage, 1);
    }

    private async Task<ApplicationUser> ResolveCurrentUserAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        return await UserManager.GetUserAsync(authState.User)
            ?? throw new InvalidOperationException("Authenticated user could not be resolved.");
    }

    private string GetCurrentUserId()
    {
        return currentUserId ?? throw new InvalidOperationException("Authenticated user could not be resolved.");
    }

    private void HandlePageSizeChanged(ChangeEventArgs args)
    {
        if (args.Value is null || !int.TryParse(args.Value.ToString(), out var selectedPageSize))
        {
            return;
        }

        if (!PageSizeOptions.Contains(selectedPageSize))
        {
            return;
        }

        pageSize = selectedPageSize;
        currentPage = 1;
    }

    private void PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
        }
    }

    private void NextPage()
    {
        if (currentPage < TotalPages)
        {
            currentPage++;
        }
    }

    private void GoToPage(int pageNumber)
    {
        if (pageNumber >= 1 && pageNumber <= TotalPages)
        {
            currentPage = pageNumber;
        }
    }

    private static string FormatBytes(long bytes)
    {
        if (bytes < 1024)
        {
            return $"{bytes} B";
        }

        var kilobytes = bytes / 1024d;
        if (kilobytes < 1024)
        {
            return $"{kilobytes:F1} KB";
        }

        return $"{kilobytes / 1024d:F1} MB";
    }

    private static List<DefectBox> ParseDefects(string? defectsJson)
    {
        if (string.IsNullOrWhiteSpace(defectsJson))
        {
            return [];
        }

        try
        {
            using var document = JsonDocument.Parse(defectsJson);
            if (document.RootElement.ValueKind != JsonValueKind.Array)
            {
                return [];
            }

            var parsedDefects = new List<DefectBox>();

            foreach (var element in document.RootElement.EnumerateArray())
            {
                if (!TryReadDecimal(element, "x", out var x)
                    || !TryReadDecimal(element, "y", out var y)
                    || !TryReadDecimal(element, "width", out var width)
                    || !TryReadDecimal(element, "height", out var height))
                {
                    continue;
                }

                if (width <= 0 || height <= 0)
                {
                    continue;
                }

                parsedDefects.Add(new DefectBox(x, y, width, height));
            }

            return parsedDefects;
        }
        catch (JsonException)
        {
            return [];
        }
    }

    private static bool TryReadDecimal(JsonElement element, string propertyName, out decimal value)
    {
        value = default;

        if (!element.TryGetProperty(propertyName, out var property))
        {
            return false;
        }

        return property.ValueKind switch
        {
            JsonValueKind.Number => property.TryGetDecimal(out value),
            JsonValueKind.String => decimal.TryParse(property.GetString(), NumberStyles.Float, CultureInfo.InvariantCulture, out value),
            _ => false
        };
    }

    private string GetOverlayViewBox()
    {
        if (defectImageDimensions is null)
        {
            return "0 0 1 1";
        }

        return string.Create(
            CultureInfo.InvariantCulture,
            $"0 0 {defectImageDimensions.Width} {defectImageDimensions.Height}");
    }

    private static string FormatCoordinate(decimal value) => value.ToString(CultureInfo.InvariantCulture);

    private sealed record DefectBox(decimal X, decimal Y, decimal Width, decimal Height);

    private sealed class ImageDimensions
    {
        public int Width { get; set; }

        public int Height { get; set; }
    }
}
