@page "/images/upload"
@rendermode InteractiveServer
@using System.Globalization
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Options
@using client.Data
@using client.Data.Entities
@using client.Options
@using client.Services
@attribute [Authorize]

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject InspectionWorkflowService WorkflowService
@inject InspectionTemplateWorkflowService TemplateWorkflowService
@inject IOptions<InspectionStorageOptions> StorageOptions

<PageTitle>Upload Image</PageTitle>

<h1 class="page-title">Upload image to be inspected</h1>
<p class="text-muted">Select one template, add one or more images, and set tolerance and optional description for each image before dispatching them one by one.</p>

@if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <div class="alert @(isError ? "alert-danger" : "alert-success")" role="alert" data-testid="image-upload-status">
        @statusMessage
    </div>
}

<EditForm Model="model" OnValidSubmit="HandleSubmitAsync" FormName="upload-image" class="inspection-form" data-testid="image-upload-form">
    <DataAnnotationsValidator />
    <ValidationSummary />

    @if (templates.Count == 0)
    {
        <div class="alert alert-warning" role="alert" data-testid="image-upload-no-template-alert">
            You need at least one template before uploading an image.
            <a href="/templates/upload" class="alert-link" data-testid="image-upload-no-template-link">Upload a template</a>.
        </div>
    }

    <div class="mb-3">
        <label class="form-label" for="inspection-file">Image files</label>
        <InputFile id="inspection-file"
                   OnChange="HandleFileSelected"
                   accept="@AcceptedFileTypes"
                   multiple
                   class="form-control"
                   data-testid="image-file-input" />
        <div class="form-text">You can add more files in multiple selections. The selected template applies to every image.</div>

        @if (uploadItems.Count > 0)
        {
            <div class="mt-3 table-responsive">
                <table class="table table-sm align-middle" data-testid="image-upload-drafts-table">
                    <thead>
                        <tr>
                            <th scope="col">File</th>
                            <th scope="col">Tolerance %</th>
                            <th scope="col">Description</th>
                            <th scope="col">Status</th>
                            <th scope="col" class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var draft in uploadItems)
                        {
                            <tr data-testid="image-upload-draft-row">
                                <td>
                                    <div class="fw-semibold" data-testid="image-upload-draft-file-name">@draft.File.Name</div>
                                    <div class="text-muted small">@FormatBytes(draft.File.Size)</div>
                                </td>
                                <td style="min-width: 12rem;">
                                    <input type="number"
                                           class="form-control"
                                           min="0"
                                           max="100"
                                           step="0.01"
                                           value="@draft.ToleranceInput"
                                           disabled="@isSubmitting"
                                           @oninput="args => HandleToleranceInput(draft, args.Value?.ToString())"
                                           data-testid="image-upload-draft-tolerance-input" />
                                    @if (draft.IsToleranceInherited)
                                    {
                                        <div class="form-text">Using template default.</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(draft.ValidationMessage))
                                    {
                                        <div class="text-danger small" data-testid="image-upload-draft-validation">@draft.ValidationMessage</div>
                                    }
                                </td>
                                <td style="min-width: 18rem;">
                                    <InputTextArea @bind-Value="draft.Description"
                                                   class="form-control"
                                                   rows="2"
                                                   disabled="@isSubmitting"
                                                   data-testid="image-upload-draft-description-input" />
                                </td>
                                <td style="min-width: 16rem;">
                                    <span class="badge rounded-pill @GetDraftBadgeClass(draft.State)" data-testid="image-upload-draft-state">@GetDraftStateLabel(draft.State)</span>
                                    @if (!string.IsNullOrWhiteSpace(draft.ResultMessage))
                                    {
                                        <div class="small mt-1 @(draft.State == UploadDraftState.Failed ? "text-danger" : "text-muted")" data-testid="image-upload-draft-result">
                                            @draft.ResultMessage
                                        </div>
                                    }
                                </td>
                                <td class="text-end">
                                    <button type="button"
                                            class="btn btn-outline-danger btn-sm"
                                            disabled="@isSubmitting"
                                            @onclick="() => RemoveDraft(draft.Id)"
                                            data-testid="image-upload-draft-remove-button">
                                        Remove
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="mb-3">
        <label class="form-label" for="template">Template</label>
        <InputSelect id="template"
                     @bind-Value="model.TemplateId"
                     @bind-Value:after="HandleTemplateChanged"
                     class="form-select"
                     data-testid="image-template-select">
            <option value="">Select a template</option>
            @foreach (var template in templates)
            {
                <option value="@template.Id">@template.FriendlyName</option>
            }
        </InputSelect>
        @if (selectedTemplate is not null)
        {
            <div class="form-text" data-testid="image-template-default-tolerance">
                Default tolerance: @selectedTemplate.TolerancePercent.ToString("0.##")%
                @if (!string.IsNullOrWhiteSpace(selectedTemplate.Description))
                {
                    <span> • @selectedTemplate.Description</span>
                }
            </div>
        }
    </div>

    <button type="submit" class="btn btn-primary" disabled="@(isSubmitting || templates.Count == 0)" data-testid="image-upload-submit-button">
        @(isSubmitting ? "Uploading images..." : "Upload images")
    </button>
    <a href="/images" class="btn btn-link" data-testid="image-upload-view-images-link">View uploaded images</a>
    <a href="/templates" class="btn btn-link" data-testid="image-upload-view-templates-link">View templates</a>
</EditForm>

@code {
    private readonly UploadImageModel model = new();
    private readonly List<InspectionTemplate> templates = [];
    private readonly List<UploadImageDraft> uploadItems = [];
    private InspectionTemplate? selectedTemplate;
    private bool isSubmitting;
    private bool isError;
    private string? statusMessage;
    private string AcceptedFileTypes => string.Join(",", StorageOptions.Value.AllowedExtensions);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User)
            ?? throw new InvalidOperationException("Authenticated user could not be resolved.");

        templates.AddRange(await TemplateWorkflowService.GetUserTemplatesAsync(user.Id, CancellationToken.None));

        if (templates.Count > 0)
        {
            selectedTemplate = templates[0];
            model.TemplateId = selectedTemplate.Id;
        }
    }

    private void HandleFileSelected(InputFileChangeEventArgs args)
    {
        foreach (var file in args.GetMultipleFiles(int.MaxValue))
        {
            uploadItems.Add(new UploadImageDraft
            {
                File = file,
                Description = null,
                ToleranceInput = FormatTolerance(selectedTemplate?.TolerancePercent ?? 20m),
                IsToleranceInherited = true
            });
        }

        statusMessage = null;
        isError = false;
    }

    private async Task HandleSubmitAsync()
    {
        if (uploadItems.Count == 0)
        {
            isError = true;
            statusMessage = "Please select at least one image file.";
            return;
        }

        if (model.TemplateId is null)
        {
            isError = true;
            statusMessage = "Please select a template.";
            return;
        }

        isSubmitting = true;
        statusMessage = null;
        ResetDraftMessages();

        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = await UserManager.GetUserAsync(authState.User)
                ?? throw new InvalidOperationException("Authenticated user could not be resolved.");

            var processedDraftIds = new HashSet<Guid>();
            var queuedCount = 0;
            var dispatchFailedCount = 0;
            var uploadFailedCount = 0;
            var draftsToProcess = uploadItems.ToList();

            for (var index = 0; index < draftsToProcess.Count; index++)
            {
                var draft = draftsToProcess[index];
                draft.ValidationMessage = null;
                draft.ResultMessage = $"Processing {index + 1} of {draftsToProcess.Count}...";
                draft.State = UploadDraftState.Uploading;
                StateHasChanged();

                if (!TryValidateDraft(draft, out var tolerancePercent, out var validationMessage))
                {
                    draft.ValidationMessage = validationMessage;
                    draft.ResultMessage = validationMessage;
                    draft.State = UploadDraftState.Failed;
                    uploadFailedCount++;
                    continue;
                }

                try
                {
                    await using var fileStream = draft.File.OpenReadStream(StorageOptions.Value.MaxFileSizeBytes);
                    var inspection = await WorkflowService.CreateAsync(
                        user.Id,
                        model.TemplateId.Value,
                        draft.File.Name,
                        draft.File.ContentType,
                        draft.File.Size,
                        fileStream,
                        tolerancePercent,
                        draft.Description,
                        CancellationToken.None);

                    processedDraftIds.Add(draft.Id);

                    if (inspection.ProcessingStatus == client.Data.Entities.ProcessingStatus.Failed)
                    {
                        dispatchFailedCount++;
                        draft.State = UploadDraftState.Failed;
                        draft.ResultMessage = $"Inspection was created, but ML dispatch failed: {inspection.FailureReason}. Retry it from My Uploads.";
                    }
                    else
                    {
                        queuedCount++;
                        draft.State = UploadDraftState.Succeeded;
                        draft.ResultMessage = "Uploaded and queued for ML processing.";
                    }
                }
                catch (Exception ex)
                {
                    uploadFailedCount++;
                    draft.State = UploadDraftState.Failed;
                    draft.ResultMessage = ex.Message;
                }
                finally
                {
                    StateHasChanged();
                }
            }

            if (processedDraftIds.Count > 0)
            {
                uploadItems.RemoveAll(x => processedDraftIds.Contains(x.Id));
            }

            isError = dispatchFailedCount > 0 || uploadFailedCount > 0;
            statusMessage = BuildBatchStatusMessage(draftsToProcess.Count, queuedCount, dispatchFailedCount, uploadFailedCount);
        }
        catch (Exception ex)
        {
            isError = true;
            statusMessage = ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private Task HandleTemplateChanged()
    {
        selectedTemplate = templates.SingleOrDefault(x => x.Id == model.TemplateId);

        if (selectedTemplate is not null)
        {
            foreach (var draft in uploadItems.Where(x => x.IsToleranceInherited))
            {
                draft.ToleranceInput = FormatTolerance(selectedTemplate.TolerancePercent);
                draft.ValidationMessage = null;
            }
        }

        return Task.CompletedTask;
    }

    private void HandleToleranceInput(UploadImageDraft draft, string? value)
    {
        draft.ToleranceInput = value ?? string.Empty;
        draft.IsToleranceInherited = false;
        draft.ValidationMessage = null;

        if (draft.State != UploadDraftState.Uploading)
        {
            draft.State = UploadDraftState.Ready;
            draft.ResultMessage = null;
        }
    }

    private void RemoveDraft(Guid draftId)
    {
        uploadItems.RemoveAll(x => x.Id == draftId);
        statusMessage = null;
        isError = false;
    }

    private void ResetDraftMessages()
    {
        foreach (var draft in uploadItems)
        {
            draft.ValidationMessage = null;
            draft.ResultMessage = null;
            draft.State = UploadDraftState.Ready;
        }
    }

    private bool TryValidateDraft(UploadImageDraft draft, out decimal tolerancePercent, out string? validationMessage)
    {
        tolerancePercent = 0m;
        validationMessage = null;

        if (draft.File.Size <= 0)
        {
            validationMessage = "A non-empty image file is required.";
            return false;
        }

        if (draft.File.Size > StorageOptions.Value.MaxFileSizeBytes)
        {
            validationMessage = $"File exceeds the maximum allowed size of {StorageOptions.Value.MaxFileSizeBytes} bytes.";
            return false;
        }

        var extension = Path.GetExtension(draft.File.Name).ToLowerInvariant();
        if (string.IsNullOrWhiteSpace(extension) ||
            !StorageOptions.Value.AllowedExtensions.Contains(extension, StringComparer.OrdinalIgnoreCase))
        {
            validationMessage = "Unsupported file type.";
            return false;
        }

        if (!string.IsNullOrWhiteSpace(draft.File.ContentType) &&
            !draft.File.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
        {
            validationMessage = "Unsupported content type.";
            return false;
        }

        if (!decimal.TryParse(draft.ToleranceInput, NumberStyles.Number, CultureInfo.InvariantCulture, out tolerancePercent) &&
            !decimal.TryParse(draft.ToleranceInput, NumberStyles.Number, CultureInfo.CurrentCulture, out tolerancePercent))
        {
            validationMessage = "Tolerance must be a valid number.";
            return false;
        }

        if (tolerancePercent < 0 || tolerancePercent > 100)
        {
            validationMessage = "Tolerance must be between 0 and 100.";
            return false;
        }

        return true;
    }

    private static string BuildBatchStatusMessage(int totalCount, int queuedCount, int dispatchFailedCount, int uploadFailedCount)
    {
        var segments = new List<string>();

        if (queuedCount > 0)
        {
            segments.Add($"{queuedCount} queued");
        }

        if (dispatchFailedCount > 0)
        {
            segments.Add($"{dispatchFailedCount} created with ML dispatch failure");
        }

        if (uploadFailedCount > 0)
        {
            segments.Add($"{uploadFailedCount} not submitted");
        }

        if (segments.Count == 0)
        {
            segments.Add("no images processed");
        }

        var message = $"Processed {totalCount} image(s): {string.Join(", ", segments)}.";

        if (dispatchFailedCount > 0)
        {
            message += " Retry dispatch failures from My Uploads.";
        }

        if (uploadFailedCount > 0)
        {
            message += " Submission failures remain in the list.";
        }

        return message;
    }

    private static string GetDraftStateLabel(UploadDraftState state) => state switch
    {
        UploadDraftState.Uploading => "Processing",
        UploadDraftState.Succeeded => "Queued",
        UploadDraftState.Failed => "Failed",
        _ => "Ready"
    };

    private static string GetDraftBadgeClass(UploadDraftState state) => state switch
    {
        UploadDraftState.Uploading => "text-bg-primary",
        UploadDraftState.Succeeded => "text-bg-success",
        UploadDraftState.Failed => "text-bg-danger",
        _ => "text-bg-secondary"
    };

    private static string FormatTolerance(decimal value) => value.ToString("0.##", CultureInfo.InvariantCulture);

    private static string FormatBytes(long bytes)
    {
        if (bytes < 1024)
        {
            return $"{bytes} B";
        }

        var kilobytes = bytes / 1024d;
        if (kilobytes < 1024)
        {
            return $"{kilobytes:F1} KB";
        }

        return $"{kilobytes / 1024d:F1} MB";
    }

    private sealed class UploadImageModel
    {
        [Required]
        public Guid? TemplateId { get; set; }
    }

    private sealed class UploadImageDraft
    {
        public Guid Id { get; } = Guid.NewGuid();

        public required IBrowserFile File { get; init; }
        public string? Description { get; set; }

        public string ToleranceInput { get; set; } = string.Empty;

        public bool IsToleranceInherited { get; set; }

        public UploadDraftState State { get; set; } = UploadDraftState.Ready;

        public string? ResultMessage { get; set; }

        public string? ValidationMessage { get; set; }
    }

    private enum UploadDraftState
    {
        Ready,
        Uploading,
        Succeeded,
        Failed
    }
}
