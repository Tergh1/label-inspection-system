# Copy to `.env.prod` on the server and fill in real values. DO NOT commit .env.prod.
# Generate secrets with:  openssl rand -hex 24

# Domain Caddy serves HTTPS on (A record must point at this server's IP)
DOMAIN=label-inspection.duckdns.org

# Public IPv4 of the VPS
SERVER_IP=203.0.113.10

# Postgres superuser password (used by the client's connection string)
POSTGRES_PASSWORD=change-me-strong-password

# Password for the ml_service_user role (created by the DB init script)
ML_DB_PASSWORD=change-me-ml-db-password

# Shared secret: client's X-API-KEY -> ML service. Must match on both sides.
INSPECTION_ML_API_KEY=change-me-api-key

# Shared secret: ML service's X-Webhook-Secret -> client webhook. Must match on both sides.
INSPECTION_WEBHOOK_SECRET=change-me-webhook-secret
